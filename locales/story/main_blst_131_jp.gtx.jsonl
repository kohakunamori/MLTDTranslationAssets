{"base_version": "9.0.200+1077500", "bundle": "main_blst_131_jp.gtx", "item_key": "main_blst_131_1000_null", "source_sha256": "392ac8222acffff197fc012d7cb7a5e90391e2355f616497bc2fbfb37320c6b8", "ja": "アイドルフェスから数日後……", "zh": "偶像祭典数日后……", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
