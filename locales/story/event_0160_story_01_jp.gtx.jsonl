{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "event_0160_story_01_jp.gtx", "item_key": "event_0160_story_01_1042_018ele", "source_sha256": "083278baf6774fecd50e1d47b5a40167314f74a315ecfb9b42bcb1bee4e12407", "ja": "ヤッター！　さすがミヤだヨ～！", "zh": "太好了！不愧是美也呀～！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
