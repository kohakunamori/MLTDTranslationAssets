{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "event_0030_story_06_jp.gtx", "item_key": "event_0030_story_06_2017_010azu", "source_sha256": "05bae404b6787b16ccbfae3c17e5e4f897c49f90b86e7ba650bfa03930736aec", "ja": "ゴ～♪", "zh": "Go～♪", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "event_0030_story_06_jp.gtx", "item_key": "event_0030_story_06_2018_036kan", "source_sha256": "eb5317c0c2c2423ce58108ce18e6372779c61cef0206a870c37826bc39e80129", "ja": "ゴー！！！！", "zh": "Go！！！！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
