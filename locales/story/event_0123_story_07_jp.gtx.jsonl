{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "event_0123_story_07_jp.gtx", "item_key": "event_0123_story_07_1028", "source_sha256": "efc3ba8d926ed73f37525fa74a2cabea0267401c4a2e372c040325c8bdf0be93", "ja": "カンパイ！", "zh": "干杯！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "event_0123_story_07_jp.gtx", "item_key": "event_0123_story_07_2004_020meg", "source_sha256": "5d9c492d153d57cb16eb481b49dbd7cfad231153c9edbd3bd727e6a3949e9f5a", "ja": "ところでさ、コーデする時のテーマって、『仲のいい\n友達』だったでしょ？　美奈子は誰にしたの？", "zh": "对了，说到搭配时的主题，是“关系很好的朋友”对吧？美奈子选的是谁？", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "event_0123_story_07_jp.gtx", "item_key": "event_0123_story_07_2005_019min", "source_sha256": "e1d93968b9210ca3d18621e23ae8140199f3f6cd899848e38ae2b2ca6334a9a6", "ja": "私は、もちろん……えへへ♪", "zh": "我当然是……嘿嘿♪", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
