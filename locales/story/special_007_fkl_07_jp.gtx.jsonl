{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "special_007_fkl_07_jp.gtx", "item_key": "special_007_fkl_07_1003_051tmg", "source_sha256": "20c4a5e6e5a75dac2325fb6b24ec7b4812da692258699c676f642178226e524e", "ja": "アンドロイドに、感情が？", "zh": "机器人也会有感情吗？", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
