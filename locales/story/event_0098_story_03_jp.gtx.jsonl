{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "event_0098_story_03_jp.gtx", "item_key": "event_0098_story_03_2021_004yuk", "source_sha256": "1abc2d8105a0db46e135c6bf144e6a4a82e4882f255354aa08d2b9b41c956ba0", "ja": "きゅ～……。", "zh": "呜～～", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "event_0098_story_03_jp.gtx", "item_key": "event_0098_story_03_2022_006mak", "source_sha256": "b5166dbb489753e10c5407e07183342867342460e91d91ab4a8f478c9ad73681", "ja": "ああっ、ダメだ！　雪歩の魂が抜けていく！\nしっかりして！", "zh": "啊，糟糕！雪步要昏倒了！\n振作点啊！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
