{"base_version": "9.0.200+1077500", "bundle": "job_story_046rio_7000_jp.gtx", "item_key": "job_story_046rio_7000_situation", "source_sha256": "6ca68b16ae01705b86439f4cf00794bc601cf04ecd0ee2e97cbd5ceafed93d65", "ja": "グラビア撮影のお仕事　撮影前", "zh": "写真拍摄的工作　拍摄前", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
