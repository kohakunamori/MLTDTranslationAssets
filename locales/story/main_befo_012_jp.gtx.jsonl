{"base_version": "9.0.200+1077500", "bundle": "main_befo_012_jp.gtx", "item_key": "main_befo_012_2021_020meg", "source_sha256": "0dbec2106fd5db8679a7194e0f4681baa398952290c622c326338ad3a1897540", "ja": "可憐……{$P$}……うん！", "zh": "可怜……{$P$}……嗯！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
