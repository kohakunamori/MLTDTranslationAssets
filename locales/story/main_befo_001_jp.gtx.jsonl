{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "main_befo_001_jp.gtx", "item_key": "main_befo_001_3013_015siz", "source_sha256": "080b6d96258e52c0f53cf0c462bb09b7d5bcc5d0984e4bf69bf7e32340af4d1e", "ja": "……行きましょうか、翼。\n今は、そっとしておいたほうがいいかも。", "zh": "……我们走吧，翼。\n现在让她一个人静一静比较好。", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "main_befo_001_jp.gtx", "item_key": "main_befo_001_3014_016tsu", "source_sha256": "b22b8321f2f8054f4ef0ae4289900b81cafedde2bdcf604313c3c3fc1713893a", "ja": "うん……。", "zh": "嗯……", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
