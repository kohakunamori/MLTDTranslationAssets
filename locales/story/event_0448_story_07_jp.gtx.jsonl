{"base_version": "9.0.200+1077500", "bundle": "event_0448_story_07_jp.gtx", "item_key": "event_0448_story_07_1016_014mir", "source_sha256": "08a44ccf16cbc9319a5978d9d3d237692eff225899a32c46675b354077277d8d", "ja": "えーっ！？", "zh": "咦──！？", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
