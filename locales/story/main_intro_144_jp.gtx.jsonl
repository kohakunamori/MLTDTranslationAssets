{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "main_intro_144_jp.gtx", "item_key": "main_intro_144_1045_038chz", "source_sha256": "b81cbfd0b91dfcda957c71a99e50f22498bcc100f2f496b06938b786e353a51c", "ja": "えっ？\nま、まあ、そんな感じですわ！", "zh": "诶？\n嘛、差不多就是这样啦！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
