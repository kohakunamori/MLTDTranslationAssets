{"base_version": "9.0.200+1077500", "bundle": "event_0222_story_06_jp.gtx", "item_key": "event_0222_story_06_2016_017kth", "source_sha256": "0e3cef6f04042efb40460728f969fa52f83cb93cf906d25c9ef4ae1afe0f4048", "ja": "おーっ！", "zh": "好──！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
