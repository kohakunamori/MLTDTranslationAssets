{"base_version": "9.0.200+1077500", "bundle": "main_befo_003_jp.gtx", "item_key": "main_befo_003_3009_016tsu", "source_sha256": "22761ee95e3f47bf564433e6841a28bd72a38244bd7011cf98fd26f5e3a44b4c", "ja": "大人……夜景……オシャレ……\n車……エスコート……！", "zh": "大人……夜景……打扮……\n车子……护花使者……！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
