{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "main_befo_141_jp.gtx", "item_key": "main_befo_141_1033_hinatasukinosyutuennsyatati", "source_sha256": "f89165eb326b91d31bb88b798e005c649f654bc902cb946746e21ac0406d0594", "ja": "す、すごいファンですっ！", "zh": "是、是超级厉害的粉丝！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
