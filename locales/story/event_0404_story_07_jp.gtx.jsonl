{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "event_0404_story_07_jp.gtx", "item_key": "event_0404_story_07_1027_028ari", "source_sha256": "bffff1861864b0019bccaa22b00c4e0ced40492cb7b4ba3982e39aecd5aafe72", "ja": "ありがとうございますぅ！", "zh": "谢谢您～！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
