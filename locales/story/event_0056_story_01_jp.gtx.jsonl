{"base_version": "9.0.200+1077500", "bundle": "event_0056_story_01_jp.gtx", "item_key": "event_0056_story_01_1072_017kth", "source_sha256": "b96bdef1da1baed37785b5d34cd69d3ebf0727a310e843be161a905b96889201", "ja": "はいっ！", "zh": "好的！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
