{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "main_after_153_jp.gtx", "item_key": "main_after_153_1028_karennpapa", "source_sha256": "417e1f10f78aa3ab29854f999240866febcf3f7051031d1b3405c5fc04a94ad7", "ja": "えっ。こんな時間にどうしたんだい？", "zh": "诶，这么晚了，怎么了？", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
