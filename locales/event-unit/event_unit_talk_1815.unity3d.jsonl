{"asset_version":"1077950","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1815.unity3d","item_key":"commands[61].text","source_sha256":"eb3f4feea80a3ab076860218c2b1123254e9631d3c3195163154d8865e4609d4","ja":"私はイリュージョンもできるディーラーなのです。\n……えっへん。","zh":"我是连魔术都能变的荷官。\n……哼哼。","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-27T06:10:41+00:00"}
