{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1050.unity3d","item_key":"commands[7].text","source_sha256":"5bc4c76c87e56277656f48364e9c2f92d48141c84cf1604888853db557ca7ea4","ja":"ラストは一番大きい声で、\n最っ高に盛り上がろーっ！！","zh":"最后一曲要用最大的声音，\n嗨到最——高潮吧！！","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T13:52:32+00:00"}
