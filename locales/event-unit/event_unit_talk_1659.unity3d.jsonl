{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1659.unity3d","item_key":"commands[28].text","source_sha256":"e9f6a07605c46eabc3be2ad6456b2a2d870d0705ebf77c6683aae5f3f790b0d5","ja":"はあ～……紬さん、すごいねぇ。\nあたしでよければ、もちろん付き合うよぉ。","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:17+00:00"}
