{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1729.unity3d","item_key":"commands[48].text","source_sha256":"7dbe352258f8677b4c39f53a264ffe358f384c7983b0781e52a4bb4c50fa120b","ja":"ふふ、ありがと！　でも確かに、\n急に近所で評判になったわけじゃないみたい。","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:17+00:00"}
