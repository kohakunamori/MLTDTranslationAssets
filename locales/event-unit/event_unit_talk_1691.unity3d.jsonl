{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1691.unity3d","item_key":"commands[15].text","source_sha256":"f238dc66a9102bad3b572320997b3b98d5648556829cb5a986cb80691b8033c6","ja":"めんこい絵だねぇ。\nえーっと……。","zh":"好可爱的画呢。\n嗯——……","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T16:19:09+00:00"}
