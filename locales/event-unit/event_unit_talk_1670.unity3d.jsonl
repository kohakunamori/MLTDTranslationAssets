{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1670.unity3d","item_key":"commands[19].text","source_sha256":"ba14628222cdd48ee95819117d1c198e3c4529914e1f439b388b800127e043a0","ja":"うん、本当に……それじゃあ全力で歌わせてください！\n『vivid color』！","zh":"嗯，真的……那么请让我全力演唱吧！\n《vivid color》！","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T16:09:18+00:00"}
