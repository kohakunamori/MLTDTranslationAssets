{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_926.unity3d","item_key":"commands[17].text","source_sha256":"1e4880a277118eb37d9da61d0039a55a210d2833f085a49ca476556a372f996c","ja":"みんなと活動して、少しは前に進みたいって思います。\nだから、頑張るのを頑張ることが、私の目標かな。","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:17+00:00"}
