{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1665.unity3d","item_key":"commands[26].text","source_sha256":"b3533ee310f2517edbd027472a53b2496fd8160b851788446c7fd5e0958927b7","ja":"……なーんだ！　じゃあ、お札も\n小道具ってことですよね？　よかった～。","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:17+00:00"}
