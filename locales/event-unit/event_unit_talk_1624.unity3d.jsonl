{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1624.unity3d","item_key":"commands[14].text","source_sha256":"48358f3141a61bb174da369117f212055caa35ad1cc31b7775b6d3d7cdc7d7be","ja":"うん！　すっごくステキなお店だから、\nしっかりお腹の準備をしておきたいんだ♪","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:17+00:00"}
