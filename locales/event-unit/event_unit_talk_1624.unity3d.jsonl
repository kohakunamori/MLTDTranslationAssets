{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1624.unity3d","item_key":"commands[16].text","source_sha256":"046468ead9333856bb274e79b40b32da717f9714296766fa9d9813dfef1d724e","ja":"わかりました！\nでは、歩いて参りましょう！","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:17+00:00"}
