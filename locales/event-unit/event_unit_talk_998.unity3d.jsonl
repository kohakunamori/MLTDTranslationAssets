{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_998.unity3d","item_key":"commands[5].text","source_sha256":"f52e1ca417d24b0520d83820e484180bf8c9d6afe7471103b54e6258f6b6347f","ja":"はぁ、まさか私の声で\n脱出失敗になるなんて……屈辱や……。","zh":"唉，没想到居然因为我的声音导致逃脱失败……真是屈辱……。","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T18:28:34+00:00"}
