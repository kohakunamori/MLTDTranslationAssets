{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1375.unity3d","item_key":"commands[8].text","source_sha256":"5b9ab1be6bfc8736d24aaa727ea74613ab2c5564f089ed78ef52d794179406cd","ja":"……ねえねえ、律っちゃん。\n真美たち、なんだかめっちゃ注目されてない？","zh":"……我说啊，小律。\n我们是不是超级引人注目啊？","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T15:10:10+00:00"}
