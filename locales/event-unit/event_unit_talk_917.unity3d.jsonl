{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_917.unity3d","item_key":"commands[16].text","source_sha256":"76adccfa8c6ed0faecc87d4ff54f5a3a4851fe51ac70887aefa0d6c334f9b0d0","ja":"効果は人それぞれよ！　それに全部やろうとして、\n疲れちゃったら、それこそ意味がないじゃない！","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:17+00:00"}
