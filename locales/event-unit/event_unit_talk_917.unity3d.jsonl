{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_917.unity3d","item_key":"commands[14].text","source_sha256":"bbd6bf59940a4d4d87c14bd5a4aa4d1bc9c297b02d25f6eef5c262db6de59ad5","ja":"でも私が言えるのは、ただひとつ……！\nオススメが必ず自分に合うとは限らないってことよ！","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:17+00:00"}
