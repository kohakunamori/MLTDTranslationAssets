{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1229.unity3d","item_key":"commands[9].text","source_sha256":"8d9a2ecc27ac2240687031bd4c54498fa8480c8af8b6c083c7d23367eab9c1d8","ja":"それを言うなら、私達も宇宙人の話で\n騒ぎを大きくしちゃったわけだし。","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:16+00:00"}
