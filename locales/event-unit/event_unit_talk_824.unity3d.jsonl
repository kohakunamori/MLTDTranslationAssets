{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_824.unity3d","item_key":"commands[9].text","source_sha256":"31f867ada648d2a871c97054a06948e5cb723d1dc364d48e85484b7894bde8ff","ja":"それでは、私も行きましょう。ひとりで探すより、\nふたりで探す方が効率が良いですから。","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:17+00:00"}
