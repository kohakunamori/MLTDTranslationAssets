{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1316.unity3d","item_key":"commands[31].text","source_sha256":"154d0755013d1fbdaaf896e360f965fd96e1476d240de10bda2828153dadbc2d","ja":"そうだったんだ！　このみさんの演技がよかったから、\n桃子全然気づかなかったよ……。","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:16+00:00"}
