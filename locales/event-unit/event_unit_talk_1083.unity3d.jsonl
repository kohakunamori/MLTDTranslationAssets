{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1083.unity3d","item_key":"commands[35].text","source_sha256":"f2ccc4ec0d8eafe842082ac0247632ab5707563c2eb3f761913e64c2363b3637","ja":"う～ん……でも、せっかくのお仕事なのに。\n自分がやりたいくらいだぞ？","zh":"嗯～……可是，难得有这份工作。\n我都想自己去做了呢？","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T14:00:23+00:00"}
