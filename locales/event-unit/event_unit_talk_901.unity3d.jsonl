{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_901.unity3d","item_key":"commands[10].text","source_sha256":"f67c622bdfe44e54651c33c740a821a46d5e0ebf55b7431f73582b1d6e5c4b62","ja":"な、なんと……！\nた、確かに、お菓子とはいいがたいですが……。","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:17+00:00"}
