{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_997.unity3d","item_key":"commands[15].text","source_sha256":"c1047d418b9ae168d68aa4be625ed86ab469509fef6fa4d2add1e439fc061168","ja":"「それ以上はダメだよ、余所者さん……」","zh":"“不能再继续了，外乡人……”","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T18:28:34+00:00"}
