{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_997.unity3d","item_key":"commands[17].text","source_sha256":"cce2ea367fc1360c334269e3e50a3a7fbc0cbbfe9e233c6bec20b735c9332d10","ja":"お芝居で使われたセリフだねぇ。\n脱出アトラクションだと、どういう意味なんだろか？","zh":"这是戏剧里用过的台词呢。\n在逃脱游乐设施里，又是什么意思呢？","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T18:28:34+00:00"}
