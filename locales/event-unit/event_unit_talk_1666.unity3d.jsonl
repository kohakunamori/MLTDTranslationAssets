{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1666.unity3d","item_key":"commands[11].text","source_sha256":"10ddc1718f4bb558da3c611d18c70cb8a1e84519738895bad9f625367ec16a65","ja":"なるほど……。雑誌を見て同じのを注文する人も\nいるだろうし、しっかり選ばないといけないよね！","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:17+00:00"}
