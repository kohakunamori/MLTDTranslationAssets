{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1649.unity3d","item_key":"commands[30].text","source_sha256":"bcd25e1d2fc72364ac2b2803ed0815d84df48cc6cdec369d3a121d88e71f3034","ja":"『うむ！　上腕二頭筋が今日も元気に\nうなりをあげているぞ！』なーんてね！","zh":"“唔！肱二头肌今天也充满活力地\n在咆哮呢！”开～玩笑的啦！","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T15:58:26+00:00"}
