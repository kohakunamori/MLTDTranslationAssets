{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1790.unity3d","item_key":"commands[25].text","source_sha256":"0aace7049c9cfc1ec82746cd0416704d2a553b90a33bc20185a99b1b7e0f9770","ja":"わ～い！\n今日は私も、ばっちり当てちゃいますよ～！","zh":"哇～！\n今天我也一定能猜中的～！","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T17:01:01+00:00"}
