{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1056.unity3d","item_key":"commands[20].text","source_sha256":"c9eff96c7688a54a48c2a900a2dc471af9e8b064e6f0adc1d2a3542d95dae740","ja":"まあっ♪　ワンピースでデートなんて、\nとってもロマンチックね♪","zh":"哎呀♪　穿着连衣裙去约会什么的，\n真是太浪漫了呢♪","status":"accepted","translation_stage":"llm_translated","updated_at":"2026-10-13T13:52:32+00:00"}
