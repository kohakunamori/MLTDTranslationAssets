{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1288.unity3d","item_key":"commands[17].text","source_sha256":"a9b4b748d32aa03dbe64ca1d74d37b85f97a81f145abc4550d4ad1d2ff8c874d","ja":"お、追いかけてるんですけど、速すぎて……！","zh":"我、我正在追，可是它太快了……！","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T14:41:40+00:00"}
