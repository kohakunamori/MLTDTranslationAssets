{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1661.unity3d","item_key":"commands[7].text","source_sha256":"356374a09d41c713b5ca95d6327b9291c321f9489c47a3075b21bb20ec45ebf8","ja":"あっ！　リンゴは血糖値上昇を抑えられるって\nネットに書いてる！　食べてみるね♪","zh":"","status":"untranslated","translation_stage":"untranslated","updated_at":"2026-10-13T06:48:17+00:00"}
