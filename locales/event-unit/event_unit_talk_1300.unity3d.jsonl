{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1300.unity3d","item_key":"commands[5].text","source_sha256":"daafa8609c435b9f72167cd81bd667d6497eb00ef3a00f15033a54599af9c6b4","ja":"なによ、対戦相手のこのダンス！\nものすごいレベルじゃない！","zh":"搞什么呀，对手的这段舞蹈！\n水平也太惊人了吧！","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T14:50:11+00:00"}
