{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1415.unity3d","item_key":"commands[17].text","source_sha256":"e8bc65180e4dfe13b7f1776d537658aefff3c53d59c85c2f03fa4943c0d9355a","ja":"ちょっと、珍しいくらいかも。","zh":"可能都算得上是有些少见呢。","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T15:10:10+00:00"}
