{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1415.unity3d","item_key":"commands[8].text","source_sha256":"25312a9105aa58c5ee8899abcdacdceaf0bd03e4523c727b35a771bc9bfddbd7","ja":"「ありがとうございます。\nでは、天空橋さんからは……」","zh":"“非常感谢。\n那么，天空桥同学……”","status":"pending","translation_stage":"llm_translated","updated_at":"2026-10-13T15:10:10+00:00"}
