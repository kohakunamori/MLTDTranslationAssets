{"asset_version":"1077750","client_version":null,"source_client_version":"9.0.200","bundle":"event_unit_talk_1423.unity3d","item_key":"commands[25].text","source_sha256":"7d1bb07782e9fe36f622b805abf3299bafe5e5395a68c80323c45a64fbcc17b9","ja":"ウニャ～！\n熱血路線はもうこりごりだよ～っ！","zh":"喵呜～！\n我再也不想走热血路线了啦～！","status":"accepted","translation_stage":"llm_translated","updated_at":"2026-10-13T15:10:10+00:00"}
