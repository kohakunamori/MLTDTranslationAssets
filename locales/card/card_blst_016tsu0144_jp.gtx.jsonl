{"base_version": "9.0.200+1077500", "bundle": "card_blst_016tsu0144_jp.gtx", "item_key": "card_blst_016tsu0144_1014_p", "source_sha256": "698bceb8b2cde22b3e18c7997b79111a01188443db7d58daa8772fe9dfeca06c", "ja": "え？", "zh": "咦？", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
