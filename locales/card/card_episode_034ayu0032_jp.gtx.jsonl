{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "card_episode_034ayu0032_jp.gtx", "item_key": "card_episode_034ayu0032_1005_034ayu", "source_sha256": "52fb220dd9c7577fa415201409921eb606664df2df8096aaa3c1893a51de23d6", "ja": "っ……ごめん、{$P$}！！", "zh": "呜……抱歉，{$P$}！！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
