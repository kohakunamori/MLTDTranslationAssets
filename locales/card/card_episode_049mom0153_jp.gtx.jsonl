{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "card_episode_049mom0153_jp.gtx", "item_key": "card_episode_049mom0153_1007_049mom", "source_sha256": "37de79ae50ad2f2bf89d1dc468759f248f72a1bfd5b26d4852c987715383da4d", "ja": "せーの……\nお兄ちゃんのばかっ！！！", "zh": "预备……\n哥哥是大笨蛋！！！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
