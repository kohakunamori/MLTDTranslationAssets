{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "card_blst_026yur0434_jp.gtx", "item_key": "card_blst_026yur0434_1022_026yur", "source_sha256": "ecb6643102ef55fca2e51492e5f37dde61d3f9c92771339873f29dfc4d239f86", "ja": "{$P$}さん！\nもう、私のこと、ちゃんと見てくださいってば～！", "zh": "{$P$}先生！\n真是的，好好看着我嘛～！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
