{"base_version": "9.0.200+1077500", "bundle": "card_episode_028ari0212_jp.gtx", "item_key": "card_episode_028ari0212_1001_028ari", "source_sha256": "65566d7840595e053f0cece57eff97b01fe63b89bb35fe45b7ae0316b63f77af", "ja": "ムフ、ムフフ……♪\n{$P$}さん、お疲れさまです！", "zh": "嗯哼、嗯呼呼……♪\n{$P$}先生，辛苦了！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
