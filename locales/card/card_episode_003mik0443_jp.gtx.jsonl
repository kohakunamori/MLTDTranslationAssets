{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "card_episode_003mik0443_jp.gtx", "item_key": "card_episode_003mik0443_1003_camman", "source_sha256": "643a2cf8ab0bcbd3ccec710c7cf26f3d2f213c7d4790e2170c3438545e73da77", "ja": "こちらにもお願いします！！\nできれば、ちょっと振り返ったポーズで！", "zh": "这边也拜托了！！\n可以的话，摆个稍微回头的姿势！", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "card_episode_003mik0443_jp.gtx", "item_key": "card_episode_003mik0443_1004_003mik", "source_sha256": "847f4b0071e22b67e53d942d41fff093a849a49706b466956d7e557f459b2f36", "ja": "こう？　あはっ☆", "zh": "这样？啊哈☆", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
