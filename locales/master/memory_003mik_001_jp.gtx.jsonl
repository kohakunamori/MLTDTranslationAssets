{"asset_version": "1077500", "client_version": null, "source_client_version": "9.0.200", "bundle": "memory_003mik_001_jp.gtx", "item_key": "memory_003mik_001_2006_p", "source_sha256": "a4c2fa9b5474a52d3abfec33a8d806621f4b363de530e92e631c29487520fe39", "ja": "ああ、そうなると思う。", "zh": "对，我想应该是。", "status": "accepted", "updated_at": "2026-09-27T00:00:00Z"}
