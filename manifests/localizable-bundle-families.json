{
  "schema_version": 1,
  "kind": "mltd-localizable-bundle-families",
  "description": "已具备抽取与回写链路的文本家族。图片家族仅做覆盖检测，不参与自动汉化；纹理可能包含日文，不再假定其文字来自 GTX 表。覆盖与缺口记录于 manifests/localization-coverage.json。reviewed_unclassified 只抑制资源类型告警，不代表已汉化。",
  "families": [
    {
      "id": "gtx_text",
      "pipeline": "gtx_text",
      "queue": "locales/master/official-<asset_version>-untranslated.jsonl",
      "match": {
        "suffix": "_jp.gtx.unity3d"
      },
      "reason": "游戏正文文本包：UnityFS 内的单个 GTX TextAsset，已由 pipelines/text 的 build-overlay 写入器回写，并进入 generated/<asset_version>/ 发布。"
    },
    {
      "id": "song_lyrics",
      "pipeline": "song_lyrics",
      "queue": "lyrics/songs/<bundle>.jsonl",
      "match": {
        "prefix": "scrobj_"
      },
      "reason": "歌曲歌词 MonoBehaviour scenario[*].str，由歌词抽取及 build_lyric_overlay 回写进入 generated 发布。"
    },
    {
      "id": "event_unit_dialogue",
      "pipeline": "event_units",
      "queue": "locales/event-unit/<bundle>.jsonl",
      "match": {
        "regex": "event_unit_talk_\\d+\\.unity3d"
      },
      "reason": "commands[index].text；event_unit_localization 仅处理数字编号对话包，按位置与源哈希回写并验证整个 JSON 和其余 Unity 对象。"
    }
  ],
  "exclude": [
    "scrobj_00test.unity3d"
  ],
  "reviewed_unclassified": [
    "event_#_story_#.acb",
    "event_#_story_intro.acb",
    "event_#_story_chat.acb",
    "card_episode_",
    "card_list_",
    "main_chat_",
    "fhout_event_",
    "blog",
    "unit_list_intro_",
    "event_#_info",
    "event_#_#_info",
    "event_unit_talk_chr_",
    "tutorialinfo",
    "igp_tutorial_info_",
    "specialeventinfo",
    "costumesalesinfo",
    "pinkyringstonesalesinfo",
    "titlebg_"
  ]
}
